# Copy to .env.local for local testing, or add these in Vercel → Project → Settings → Environment Variables.
# Never commit real values.

# Website Supabase project (London) — NOT the app's project
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Cloudflare Turnstile (spam protection)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Resend (email notifications for new enquiries)
RESEND_API_KEY=
NOTIFY_EMAIL=
NOTIFY_FROM=
